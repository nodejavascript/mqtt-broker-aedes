{
  "name": "mqtt-broker-aedes",
  "version": "2.0.0",
  "description": "Aedes 1.x MQTT broker with LevelDB persistence, written in TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "docker": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nodejavascript/mqtt-broker-aedes.git"
  },
  "keywords": [
    "mqtt",
    "aedes",
    "broker",
    "typescript",
    "leveldb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aedes": "^1.2.0",
    "aedes-persistence-level": "^9.2.0",
    "dotenv": "^18.0.9",
    "level": "^10.0.0",
    "mqemitter": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "mqtt": "^5.16.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
